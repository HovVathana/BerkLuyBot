# Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...
BOT_USERNAME=my_salary_bot

# Database (Prisma + Supabase Postgres)
# Supabase dashboard: Project Settings -> Database -> Connection string
#   - DATABASE_URL uses the TRANSACTION connection pooler (port 6543) —
#     required for serverless; pgbouncer mode + connection_limit=1.
#   - DATABASE_URL_DIRECT is the direct/session connection — used by `prisma
#     migrate deploy` for DDL.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL_DIRECT="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Payday / reminders
# Timezone used to decide what "today" is for paydays & OT dates.
# (Named APP_TZ because Vercel reserves the name TZ.)
APP_TZ=Asia/Phnom_Penh
# How many days before the actual payday to send the "reminder" nudge
REMIND_DAYS_BEFORE=5
# Secret required to call /api/payday (GitHub Actions / Vercel cron)
CRON_SECRET=change-me-to-a-long-random-string

# Optional AI (Gemini) payday-reminder writer — writes a funny, sarcastic Khmer
# nudge. When unset or when every model fails, the standard reminder is sent.
# GEMINI_API_KEY=your-google-ai-api-key
# Comma-separated fallback list; the first model that responds is used.
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite